<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenPixels.Desktop</RootNamespace>
    <AssemblyName>OpenPixels</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- The release version; packaging scripts and the macOS Info.plist read it from here. -->
    <Version>0.1.0</Version>
    <Product>OpenPixels</Product>
    <Copyright>OpenPixels contributors, Apache-2.0</Copyright>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Runs MODNet, SkyWater-Seg and LaMa for AI masks and AI erase. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <!-- The engine is the Rust crate op-native, built by cargo and copied next to the app, with
       openpixels-mcp (crate op-mcp), the MCP server that lets AI agents use the same engine. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepoRoot>
    <NativeLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libop_native.dylib</NativeLibName>
    <NativeLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libop_native.so</NativeLibName>
    <NativeLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">op_native.dll</NativeLibName>
    <NativeLibPath>$(RepoRoot)target/release/$(NativeLibName)</NativeLibPath>
    <McpServerPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(RepoRoot)target/release/openpixels-mcp.exe</McpServerPath>
    <McpServerPath Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(RepoRoot)target/release/openpixels-mcp</McpServerPath>
  </PropertyGroup>

  <Target Name="BuildNativeEngine" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeBuild)' != 'true'">
    <Exec Command="sh &quot;$(RepoRoot)scripts/build-native.sh&quot;" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <Exec Command="cargo build -p op-native -p op-mcp --release" WorkingDirectory="$(RepoRoot)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <Copy SourceFiles="$(NativeLibPath);$(McpServerPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Published builds carry the engine too; it is built for the machine doing the publish. -->
  <Target Name="PublishNativeEngine" AfterTargets="Publish">
    <Copy SourceFiles="$(NativeLibPath);$(McpServerPath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets/app-icon.png" />
  </ItemGroup>

  <!-- Interface translations, shared with the web edition. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)web/src/i18n/*.json" LogicalName="OpenPixels.i18n.%(Filename).json" />
  </ItemGroup>

  <!-- The AI models, if scripts/fetch-model.sh has fetched them. Checked licences are in the README. -->
  <ItemGroup>
    <None Include="$(RepoRoot)web/public/models/modnet.onnx;$(RepoRoot)web/public/models/skywater.onnx;$(RepoRoot)web/public/models/lama.onnx;$(RepoRoot)web/public/models/face_detector.onnx;$(RepoRoot)web/public/models/face_landmarks.onnx"
          Condition="Exists('$(RepoRoot)web/public/models/modnet.onnx')"
          Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Lensfun database (CC BY-SA 3.0), if scripts/fetch-lensfun.sh has fetched it. -->
  <ItemGroup>
    <None Include="$(RepoRoot)web/public/lensfun/lensfun.json;$(RepoRoot)web/public/lensfun/NOTICE.txt"
          Condition="Exists('$(RepoRoot)web/public/lensfun/lensfun.json')"
          Link="lensfun/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
